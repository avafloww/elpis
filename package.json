{
  "name": "elpis",
  "version": "0.12.0",
  "description": "A durable, self-hosted runtime for one persistent AI agent",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && npm run build:gateway-protocol && tsc && npm run copy-assets && npm run build:console",
    "build:console": "tsc -p tsconfig.console.json && node scripts/build-console.mjs",
    "build:gateway": "npm run build:gateway-protocol && npm run build --workspace @elpis/gateway",
    "copy-assets": "rm -rf dist/console/public && mkdir -p dist/console/public && cp -r src/console/public/. dist/console/public/ && cp node_modules/marked/lib/marked.umd.js dist/console/public/marked.umd.js",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "repl": "tsx src/repl.ts",
    "pretest": "npm run build:gateway-protocol",
    "test": "node --test --test-timeout=30000 --test-reporter=dot --import ./test/temp-root.mjs --import tsx/esm test/*.test.ts",
    "pretest:unit": "npm run build:gateway-protocol",
    "test:unit": "TEST_NO_NETWORK=1 node --test --test-timeout=30000 --test-reporter=dot --import ./test/temp-root.mjs --import tsx/esm test/*.test.ts",
    "test:gateway": "npm run test:gateway-protocol && npm test --workspace @elpis/gateway",
    "pretest:full-report": "npm run build:gateway-protocol",
    "test:full-report": "node --test --test-timeout=30000 --import ./test/temp-root.mjs --import tsx/esm test/*.test.ts",
    "pretest:integration": "npm run build:gateway-protocol",
    "test:integration": "node --test --test-timeout=30000 --import ./test/temp-root.mjs --import tsx/esm test/llm-integration.test.ts test/discord.test.ts",
    "deploy": "npm run build && systemctl --user restart elpis-harness && systemctl --user status elpis-harness --no-pager",
    "bench": "tsx bench/cli.ts",
    "bench:check": "tsc -p bench/tsconfig.json",
    "feedback": "tsx scripts/feedback.ts",
    "release:sync": "tsx scripts/release-sync.ts",
    "release:workflow": "tsx scripts/release-workflow.ts",
    "tools:check": "tsc -p tsconfig.tools.json",
    "oauth-login": "tsx scripts/oauth-login.ts",
    "replay-policy-denial": "tsx scripts/replay-policy-denial.ts",
    "toggle-external-thinking": "tsx scripts/toggle-external-thinking.ts",
    "build:gateway-protocol": "npm run build --workspace @elpis/gateway-protocol",
    "test:gateway-protocol": "npm test --workspace @elpis/gateway-protocol",
    "test:live-llm": "TEST_LIVE_LLM=1 node --test --test-concurrency=1 --test-timeout=30000 --import ./test/temp-root.mjs --import tsx/esm test/discord.test.ts test/llm-integration.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@elpis/gateway-protocol": "1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/cli": "^0.1.18",
    "acorn": "^8.15.0",
    "discord.js": "^14.27.0",
    "magic-string": "^0.30.17",
    "marked": "^18.0.5",
    "openai": "^5.15.0",
    "preact": "10.29.8",
    "prettier": "3.9.6",
    "prismjs": "1.30.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avafloww/elpis.git"
  },
  "bugs": {
    "url": "https://github.com/avafloww/elpis/issues"
  },
  "homepage": "https://elpis.bnuuy.systems",
  "author": "Ava Chaney",
  "overrides": {
    "@hono/node-server": "2.1.0",
    "fast-uri": "3.1.6",
    "hono": "4.12.34",
    "ip-address": "10.5.0",
    "qs": "6.16.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
