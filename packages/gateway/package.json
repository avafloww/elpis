{
  "name": "@elpis/gateway",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && mkdir -p dist/public && cp -R public/. dist/public/ && npm run typecheck:client && npm run build:client",
    "typecheck:client": "tsc -p client/tsconfig.json",
    "build:client": "node build-client.mjs",
    "pretest": "npm run build --workspace @elpis/gateway-protocol",
    "test": "TEST_NO_NETWORK=1 node --test --test-timeout=30000 --import tsx/esm test/*.test.ts"
  },
  "bin": {
    "elpis-gateway": "./dist/main.js"
  },
  "dependencies": {
    "@elpis/gateway-protocol": "1.0.0",
    "preact": "10.29.8",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "marked": "18.0.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
