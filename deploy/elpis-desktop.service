# elpis-desktop — Openbox/tint2 session for elpis.computer.
# Installed as a systemd USER unit by deploy/install.sh; Xorg is elpis-xorg.service.

[Unit]
Description=elpis desktop — Openbox session on the Proxmox-visible Xorg display
After=network.target

[Service]
Type=simple
Environment=ELPIS_DISPLAY=:0
Environment=ELPIS_GEOMETRY=1280x800
Environment=ELPIS_DESKTOP_DIR=<DATA_DIR>/elpis-data/computer
Environment=XAUTHORITY=<DATA_DIR>/elpis-data/computer/Xauthority
ExecStart=<HARNESS_ROOT>/deploy/start-desktop.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
